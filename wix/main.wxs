<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Ferrum Chess" Manufacturer="Ferrum Chess contributors"
           Version="$(var.Version)" UpgradeCode="14E52B14-59B4-4EF3-8F94-69D02F8ED7D8" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Ferrum Chess is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Ferrum Chess">
        <Component Id="AppComponent" Guid="22C07355-BD58-42BD-9A67-0B27AFF5EFC0">
          <File Id="AppFile" Source="$(var.AppPath)" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Name="Ferrum Chess" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
          </File>
        </Component>
        <Component Id="EngineComponent" Guid="511E073C-B7E8-4D85-9536-DA764A0D1C93">
          <File Id="EngineFile" Source="$(var.EnginePath)" Name="stockfish.exe" KeyPath="yes" />
        </Component>
        <Component Id="LicenseComponent" Guid="4449450D-EBEC-46E3-BF0D-8CDB8F0C2180">
          <File Id="LicenseFile" Source="$(var.StockfishLicense)" Name="Stockfish-GPL.txt" KeyPath="yes" />
        </Component>
        <Component Id="FontLicenseComponent" Guid="26EF830A-F91E-444F-A6E4-7F4E4544067F">
          <File Source="$(var.FontLicense)" Name="Noto-OFL.txt" KeyPath="yes" />
        </Component>
        <Component Id="RulesLicenseComponent" Guid="12B201B0-AD43-4A15-AB06-C12D8F3B464E">
          <File Source="$(var.RulesLicense)" Name="shakmaty-GPL.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Ferrum Chess" />
    </StandardDirectory>
    <Feature Id="Main" Title="Ferrum Chess" Level="1">
      <ComponentRef Id="AppComponent" /><ComponentRef Id="EngineComponent" /><ComponentRef Id="LicenseComponent" /><ComponentRef Id="FontLicenseComponent" /><ComponentRef Id="RulesLicenseComponent" />
    </Feature>
  </Package>
</Wix>
