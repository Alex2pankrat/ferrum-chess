<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Ferrum Chess" Manufacturer="Ferrum Chess contributors"
           Version="$(var.Version)" UpgradeCode="14E52B14-59B4-4EF3-8F94-69D02F8ED7D8" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Ferrum Chess is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- Include the standard interactive welcome, progress, error and completion dialogs.
         Silent installs (/qn) continue to work without UI. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Icon Id="FerrumIcon" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="FerrumIcon" />
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <UI>
      <Dialog Id="DesktopShortcutDlg" Width="370" Height="270" Title="Ferrum Chess Setup">
        <Control Id="Heading" Type="Text" X="20" Y="25" Width="330" Height="25" Text="Choose shortcuts" />
        <Control Id="Explanation" Type="Text" X="20" Y="60" Width="330" Height="35" Text="Ferrum Chess will be available in the Start menu. You can also add a shortcut to the desktop." />
        <Control Id="DesktopCheckbox" Type="CheckBox" X="20" Y="110" Width="320" Height="20" Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a desktop shortcut" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <Show Dialog="DesktopShortcutDlg" Before="WelcomeEulaDlg" Condition="NOT Installed" />
    </InstallUISequence>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Open Ferrum Chess from the Start menu after installation." />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Ferrum Chess">
        <Component Id="AppComponent" Guid="22C07355-BD58-42BD-9A67-0B27AFF5EFC0">
          <File Id="AppFile" Source="$(var.AppPath)" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Name="Ferrum Chess" WorkingDirectory="INSTALLFOLDER" Icon="FerrumIcon" Advertise="yes" />
          </File>
        </Component>
        <Component Id="EngineComponent" Guid="511E073C-B7E8-4D85-9536-DA764A0D1C93">
          <File Id="EngineFile" Source="$(var.EnginePath)" Name="stockfish.exe" KeyPath="yes" />
        </Component>
        <Component Id="LicenseComponent" Guid="4449450D-EBEC-46E3-BF0D-8CDB8F0C2180">
          <File Id="LicenseFile" Source="$(var.StockfishLicense)" Name="Stockfish-GPL.txt" KeyPath="yes" />
        </Component>
        <Component Id="FontLicenseComponent" Guid="26EF830A-F91E-444F-A6E4-7F4E4544067F">
          <File Source="$(var.FontLicense)" Name="Noto-OFL.txt" KeyPath="yes" />
        </Component>
        <Component Id="PieceNoticeComponent" Guid="B08F048B-0A07-46E4-861E-557D77F1F40E">
          <File Source="$(var.PieceNotice)" Name="Chess-Pieces-Public-Domain.txt" KeyPath="yes" />
        </Component>
        <Component Id="ReadmeComponent" Guid="69EBA1B2-65BB-4C55-829D-55A3AF627545">
          <File Source="$(var.Readme)" Name="README.txt" KeyPath="yes" />
        </Component>
        <Component Id="MitComponent" Guid="3670A6AC-A75A-44E4-836A-6A7B355E34C5">
          <File Source="$(var.MitLicense)" Name="LICENSE-MIT.txt" KeyPath="yes" />
        </Component>
        <Component Id="ApacheComponent" Guid="5C6A75AA-C81D-4D80-9D4E-EF6B19581C67">
          <File Source="$(var.ApacheLicense)" Name="LICENSE-APACHE.txt" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="9982524F-19D9-4B6E-8954-B221F7148F3D" Condition="DESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="Ferrum Chess" Target="[#AppFile]" WorkingDirectory="INSTALLFOLDER" Icon="FerrumIcon" />
        <RegistryValue Root="HKLM" Key="Software\Ferrum Chess" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Ferrum Chess" />
    </StandardDirectory>
    <Feature Id="Main" Title="Ferrum Chess" Level="1">
      <ComponentRef Id="AppComponent" /><ComponentRef Id="DesktopShortcutComponent" /><ComponentRef Id="EngineComponent" /><ComponentRef Id="LicenseComponent" /><ComponentRef Id="FontLicenseComponent" /><ComponentRef Id="PieceNoticeComponent" /><ComponentRef Id="ReadmeComponent" /><ComponentRef Id="MitComponent" /><ComponentRef Id="ApacheComponent" />
    </Feature>
  </Package>
</Wix>
